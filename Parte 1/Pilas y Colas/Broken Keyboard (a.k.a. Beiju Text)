#include <iostream>
#include <string>
#include <list>

using namespace std;

int main() {
	ios_base::sync_with_stdio(0); cin.tie(0);
	string s;
	while (cin >> s) {
		list<char> text;
		auto it = text.begin();
		for (char c : s) {
			if (c == '[') {
				it = text.begin();
			} else if (c == ']') {
				it = text.end();
			} else {
				text.insert(it, c);
			}
		}
		for (char c : text) cout << c;
		cout << "\n";
	}
	return 0;
}
